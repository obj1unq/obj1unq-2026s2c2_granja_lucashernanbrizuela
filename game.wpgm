import wollok.game.*
import granja.personaje.*
import cultivos.*

program lagranja {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("fondo.png")

	keyboard.g().onPressDo({granja.personaje.cambiarGenero()})
 	game.addVisualCharacter(granja.personaje)
 	

 	//  COMIENZA
	game.start()
}
